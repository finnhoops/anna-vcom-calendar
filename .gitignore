# Old builds — 19MB of history the pipeline regenerates anyway
versions/

# The generated page is COMMITTED on purpose — Vercel deploys it from this repo
# on every push to master (see vercel.json "outputDirectory": "build").
# Do not re-ignore build/index.html or pushes will publish an empty site.

# Design proof images — dev artifacts, not part of the deployed page
build/*.png

# Vercel account bookkeeping — machine-specific, must not travel
build/.vercel/

# Python
__pycache__/
*.pyc

# Working files
data/.schedule_prev.json
.DS_Store
